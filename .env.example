# ---------------------------------------------------------------
# HireFlow configuration. Copy to `.env` and fill in the values.
# ---------------------------------------------------------------
NODE_ENV=development
LOG_LEVEL=info

# ---------- Company / App ----------
COMPANY_NAME=Your Company
# Public URL of the web app (used in candidate links inside emails)
APP_URL=http://localhost:5173
# Comma-separated list of allowed browser origins for the API gateway
CORS_ORIGINS=http://localhost:5173
# Shared secret used for service-to-service calls. Use a long random string.
INTERNAL_API_KEY=change-me-to-a-long-random-string
# Default currency for jobs/offers (ISO 4217)
DEFAULT_CURRENCY=INR

# ---------- Supabase ----------
# Project Settings -> API
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# Optional: legacy JWT secret (Project Settings -> API -> JWT secret).
# Leave empty to verify tokens via the project's JWKS endpoint (new signing keys).
SUPABASE_JWT_SECRET=
# Project Settings -> Database -> Connection string -> "Session pooler" (port 5432)
DATABASE_URL=postgresql://postgres.YOUR-PROJECT:YOUR-PASSWORD@aws-0-ap-south-1.pooler.supabase.com:5432/postgres

# ---------- Central DB service & cache ----------
# Only the `db` service (port 4010) connects to Postgres. All other services send
# their queries to it and cache reads in Redis.
DB_URL=http://localhost:4010
# Connections from the DB service to Supabase. 1 = a single shared connection.
# Raise to 2-3 if /internal/db/stats shows writes or transactions queueing.
DB_POOL_MAX=1
# Max autocommit writes group-committed in one transaction
DB_BATCH_MAX=50
# Optional extra wait (ms) to gather more writes per batch; 0 = no added latency
DB_BATCH_WINDOW_MS=0
# Waiting operations before callers get 503 DB_BUSY, and how long an op may wait
DB_QUEUE_MAX=2000
DB_QUEUE_TIMEOUT_MS=15000
# Abandoned transactions are rolled back after this much inactivity
DB_TX_IDLE_TIMEOUT_MS=10000
# enforce | warn | off: a service may only touch its own schema (+ platform.events)
DB_SCHEMA_GUARD=enforce
# Escape hatch: DB_MODE=direct makes services open their own pools again (not for production)
# DB_MODE=remote

# Redis for query caching. Each service uses its own logical database on this server
# (versions in db 0, identity 1, jobs 2, talent 3, ...). Leave empty to disable caching.
# A service can use a dedicated Redis instead, e.g. TALENT_REDIS_URL=redis://cache-talent:6379
REDIS_URL=redis://localhost:6379
CACHE_TTL_SECONDS=60
CACHE_MAX_ENTRY_KB=512
# Storage bucket for resumes & onboarding documents (created automatically, private)
STORAGE_BUCKET=hireflow-files

# ---------- AI (Groq) ----------
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
GROQ_FAST_MODEL=llama-3.1-8b-instant

# ---------- Outgoing email (SMTP) ----------
# Gmail / Google Workspace: smtp.gmail.com, 465, secure=true, use an App Password
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASS=
EMAIL_FROM="Talent Team <careers@yourcompany.com>"
# Set to true to log emails instead of sending them (useful for local testing)
EMAIL_DRY_RUN=false

# ---------- Resume inbox (IMAP, optional) ----------
# Resumes emailed to this inbox are imported automatically. Leave IMAP_HOST empty to disable.
IMAP_HOST=
IMAP_PORT=993
IMAP_USER=
IMAP_PASS=
IMAP_MAILBOX=INBOX
IMAP_POLL_SECONDS=120

# ---------- Ports / service discovery (local dev defaults) ----------
GATEWAY_PORT=4000
IDENTITY_URL=http://localhost:4001
JOBS_URL=http://localhost:4002
TALENT_URL=http://localhost:4003
ASSESSMENT_URL=http://localhost:4004
INTERVIEW_URL=http://localhost:4005
OFFER_URL=http://localhost:4006
ONBOARDING_URL=http://localhost:4007
AI_URL=http://localhost:4008
NOTIFICATION_URL=http://localhost:4009

# ---------- Frontend (Vite, exposed to the browser) ----------
VITE_API_URL=http://localhost:4000
VITE_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=
VITE_COMPANY_NAME=Your Company
